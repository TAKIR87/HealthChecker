[flake8]
max-line-length = 100
exclude =
    .venv,
    venv,
    __pycache__,
    .git,
    logs,
    data
extend-ignore =
    # E203: whitespace before ':' — конфликтует с форматированием Black
    E203,
    # W503: line break before binary operator — устаревшее правило, Black делает наоборот
    W503
